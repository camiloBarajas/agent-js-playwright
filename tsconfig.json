{
  "compilerOptions": {
    "sourceMap": true,
    "esModuleInterop": true,
    "allowJs": false,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "downlevelIteration": true,
    "declaration": true,
    "lib": ["es2016", "es2016.array.include", "dom"],
    "module": "commonjs",
    "target": "es6",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "types/*"]
    },
    "typeRoots": ["./node_modules/@types", "types"],
    "outDir": "./build"
  },
  "include": ["./src/**/*", "mocks", "tests/utils.spec.ts", "index.ts", "reporter.ts", "reportingApi.ts", "utils.ts", "constants", "tests/reporter", "types"],
  "exclude": ["node_modules", "src/__tests__"]
}
